# Copy this file to .env and replace every "change-me" value with your own local password.
# .env is gitignored. Never commit real credentials.
# Use letters and digits in passwords; characters like @ : / # must be percent-encoded in URLs.

# Superuser password for the Postgres container. Docker Compose reads this.
# It only takes effect the first time the database volume is created.
POSTGRES_PASSWORD=change-me-admin

# Admin (superuser) connection. Used ONLY by the bootstrap/migrate commands and the
# guarded test-database reset. The running API never reads this variable.
# Its password must match POSTGRES_PASSWORD.
DATABASE_ADMIN_URL=postgresql://postgres:change-me-admin@127.0.0.1:5432/incidentlens

# Application role used by the FastAPI backend. The user must be "incidentlens_app".
DATABASE_URL=postgresql://incidentlens_app:change-me-app@127.0.0.1:5432/incidentlens

# Read-only role used by the agent's investigation tools. The user must be "tools_ro".
TOOLS_RO_DATABASE_URL=postgresql://tools_ro:change-me-ro@127.0.0.1:5432/incidentlens

# Throwaway database for pytest. Must be exactly "incidentlens_test" (enforced by the test guard).
# Leave unset to skip database tests.
TEST_DATABASE_NAME=incidentlens_test
