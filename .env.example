# IncidentLens configuration. Copy this file to .env for local development and replace every
# "change-me" value. .env is gitignored: never commit real credentials.
# In production, set these as platform secrets/variables instead of using a file.
# Passwords: use letters and digits; characters like @ : / # must be percent-encoded in URLs.

# ---------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------

# Superuser password for the local Postgres container (docker-compose.yml reads it).
# Only takes effect the first time the database volume is created.
POSTGRES_PASSWORD=change-me-admin

# Admin (superuser) connection. Used ONLY by the maintenance commands: bootstrap, migrate, seed,
# runbook ingestion (`python -m app.db.release`), pruning (`python -m app.db.prune`) and the
# guarded test-database reset. In production, give it ONLY to the one-off release job, never to
# the web service (the API logs a warning if it finds this variable in its environment).
DATABASE_ADMIN_URL=postgresql://postgres:change-me-admin@127.0.0.1:5432/incidentlens

# Application role used by the web service. The user must be "incidentlens_app".
DATABASE_URL=postgresql://incidentlens_app:change-me-app@127.0.0.1:5432/incidentlens

# Read-only role used by the agent's investigation tools. The user must be "tools_ro".
TOOLS_RO_DATABASE_URL=postgresql://tools_ro:change-me-ro@127.0.0.1:5432/incidentlens

# Throwaway database for pytest. Must be exactly "incidentlens_test" (enforced by the test guard);
# the tests drop and recreate it. Leave unset to skip database tests. Not needed in production.
TEST_DATABASE_NAME=incidentlens_test

# ---------------------------------------------------------------------------------------------
# Public deployment
# ---------------------------------------------------------------------------------------------

# true = public deployment: session cookies are Secure (HTTPS only, "__Host-" prefix) and the UI
# shows the "simulated demo data" banner. In every mode the four demo incidents are public and
# read-only, and incidents users create are private to the account that created them.
# Default false for local development over plain HTTP. The Docker image sets it to true.
# PUBLIC_DEMO_MODE=false

# ---------------------------------------------------------------------------------------------
# Accounts and sessions
# ---------------------------------------------------------------------------------------------
# Passwords are stored only as Argon2id hashes; sessions are random tokens in an HttpOnly,
# SameSite=Lax cookie (only a SHA-256 of the token is stored). No secret key is needed.
# REGISTRATION_ENABLED=true            # false = existing accounts can sign in, nobody can register
# SESSION_TTL_HOURS=168                # sessions expire after 7 days
# SESSION_COOKIE_SECURE=               # empty = follow PUBLIC_DEMO_MODE; true/false to override
#                                      # (must be true whenever the site is served over HTTPS)
# LOGIN_ATTEMPTS_PER_IP_PER_15MIN=20
# LOGIN_FAILURES_PER_EMAIL_PER_15MIN=5 # then that email is locked for the rest of the window
# REGISTRATIONS_PER_IP_PER_HOUR=5
# REGISTRATIONS_PER_HOUR=100           # across all clients
# MAX_INCIDENTS_PER_USER=20            # incidents one account can keep (delete one to add more)
# MAX_RUNS_PER_USER_PER_HOUR=10        # investigations one account (or anonymous IP, on demos) may start

# ---------------------------------------------------------------------------------------------
# LLM (Groq, OpenAI-compatible API)
# ---------------------------------------------------------------------------------------------

# Create a key at https://console.groq.com/keys. Without a real key the app still runs, but
# starting investigations returns 503. Placeholder values containing "change-me" are ignored.
GROQ_API_KEY=change-me-groq
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# LLM_TIMEOUT_SECONDS=30           # per model call
# LLM_MAX_RETRIES=4                # SDK retries for 429/5xx, honouring retry-after

# Persistent cache of model responses (llm_cache table). Off by default: cached conversations
# contain incident evidence, and a re-run with unchanged evidence would replay the old answer.
# Entries are keyed by the incident's exact evidence version, so new evidence never reuses them.
# The evaluation command can enable it per run with --cache.
# LLM_CACHE_ENABLED=false

# ---------------------------------------------------------------------------------------------
# Agent budgets (every investigation is bounded by these)
# ---------------------------------------------------------------------------------------------
# AGENT_MAX_ITERATIONS=8           # model turns per investigation
# AGENT_MAX_TOOL_CALLS=10          # read-only tool calls per investigation
# AGENT_MAX_TOOL_RESULT_CHARS=3500 # each tool result is trimmed to fit this size

# ---------------------------------------------------------------------------------------------
# Abuse and storage limits (in-memory per process; reset on restart)
# ---------------------------------------------------------------------------------------------
# MAX_CONCURRENT_RUNS=2            # investigations running at once
# MAX_RUNS_PER_HOUR=20             # investigations started per rolling hour
# MAX_INCIDENTS_PER_HOUR=30        # user incidents created per rolling hour
# MAX_USER_INCIDENTS=200           # total user incidents stored, across all accounts
# MAX_INCIDENT_LOG_ENTRIES=5000    # per incident (at most 9999)
# MAX_INCIDENT_METRIC_POINTS=2000  # per incident
# MAX_INCIDENT_DEPLOYMENTS=200     # per incident
# MAX_REQUEST_BYTES=4000000        # any request body, enforced while it streams in
# USER_INCIDENT_RETENTION_DAYS=30  # default age for `python -m app.db.prune` (never deletes demos)

# ---------------------------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------------------------
# CORS_ORIGINS=                    # comma-separated; only if the frontend is on another origin.
#                                  # Also the only foreign origins allowed to send POST/DELETE.
# FRONTEND_DIST=../frontend/dist   # built React app served at "/" (the Docker image sets this)
